# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://teambrain:teambrain@localhost:5432/teambrain

# Auth.js session signing key. Generate with `npx auth secret`
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

