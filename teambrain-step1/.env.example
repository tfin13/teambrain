# Copy to .env.local and fill in. Never commit .env.local.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://teambrain:teambrain@localhost:5432/teambrain

# Auth.js session signing key. Generate with `npx auth secret`
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# GitHub OAuth sign-in. Create a new app at https://github.com/settings/applications/new
GITHUB_ID=
GITHUB_SECRET=

# Claude API key for Chat. Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
